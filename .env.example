# Postgres connection string. On Railway, add a PostgreSQL plugin to this project
# and Railway will inject DATABASE_URL automatically — you generally don't need to
# set this by hand in the Railway dashboard, only for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jfy_alterations"

# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-long-random-string"

# Optional: only needed if you want the client tracking link to use a specific
# domain instead of the request's own host header (Railway sets this fine by default).
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# Used only by `npm run db:seed` to create the first manager login.
SEED_MANAGER_EMAIL="manager@justforyoualterations.com"
SEED_MANAGER_PASSWORD="changeme123!"

# Phase 2 (timeclock + scheduling) — off by default. The tables and pages exist in the
# build either way; this only controls whether staff can reach them (nav links + route
# access). Set to "true" and redeploy/restart to turn on; remove it (or set it to
# anything else) and redeploy/restart to turn back off — no code changes needed either
# way. See lib/feature-flags.ts and phase2/PLAN.md.
# PHASE2_ENABLED="true"
