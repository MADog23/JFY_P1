// Just For You Alterations — Phase 1 digital ticket system
// Data model notes:
// - Every mutating action is expected to also write an AuditLog row (see lib/audit.ts)
// - OrderItem "intake" fields (garmentType, description, alterations) are locked after
//   creation and can only be changed by a MANAGER (see actions/items.ts)
// - Order.status / OrderItem.status are recomputed by lib/order-status.ts, not set by hand,
//   so the "sealed until a manager reopens" rule can never be bypassed by a stray write.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
}

enum OrderStatus {
  IN_PROGRESS // at least one item not yet completed
  SEALED // every item COMPLETED (or PICKED_UP) — read-only until a manager reopens an item
  PICKED_UP // every item has been picked up — order fully closed
  // A manager's soft-cancel for an order that should never have existed (duplicate
  // intake, wrong client, a test ticket) — see actions/orders.ts:cancelOrder. Sticky:
  // recomputeOrderStatus (lib/order-status.ts) never overwrites this from item status
  // changes; only uncancelOrder recomputes it back to a live status. Deliberately not a
  // delete — the order, its items, notes, and audit trail all survive untouched and
  // reversible, consistent with how nothing else in this app is ever truly erased.
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
}

enum ItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED // locked — only a manager can reopen
  PICKED_UP // locked — terminal
}

// Where a PriceLine's description came from — purely informational (drives the
// receipt UI grouping), not a permissions distinction.
enum PriceLineSource {
  ALTERATION // auto-generated from a selected alteration checkbox
  CUSTOM_INSTRUCTIONS // auto-generated from an item's alterationsCustom free text
  FREEFORM // manually added by whoever was pricing the ticket (item- or order-level)
}

model User {
  id        String   @id @default(cuid())
  name      String
  role      Role
  active    Boolean  @default(true)

  // Employees authenticate with a PIN (hashed). Managers authenticate with email + password.
  pinHash      String?
  email        String?  @unique
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersCreated   Order[]        @relation("OrderCreatedBy")
  notes           ItemNote[]
  measurements    ItemMeasurement[]
  images          ItemImage[]
  pickupsHandled  ItemPickup[]   @relation("PickupAuthorizedBy")
  auditLogs       AuditLog[]
  priceLinesCreated PriceLine[]  @relation("PriceLineCreatedBy")
  priceLinesUpdated PriceLine[]  @relation("PriceLineUpdatedBy")
  itemsAssignedToMe OrderItem[]  @relation("ItemAssignedTo")
  itemsAssignedByMe OrderItem[]  @relation("ItemAssignedBy")
  itemsRemovedByMe  OrderItem[]  @relation("ItemRemovedBy")

  // Phase 2 (timeclock + scheduling) — gated behind PHASE2_ENABLED (see
  // lib/feature-flags.ts) but the tables exist regardless of the flag.
  punches         Punch[]  @relation("PunchOwner")
  punchesCreated  Punch[]  @relation("PunchCreatedBy")
  punchesEdited   Punch[]  @relation("PunchEditedBy")
  punchesVoided   Punch[]  @relation("PunchVoidedBy")
  shiftsAssigned  Shift[]  @relation("ShiftAssignee")
  shiftsCreated   Shift[]  @relation("ShiftCreatedBy")
  shiftsCancelled Shift[]  @relation("ShiftCancelledBy")
}

model Order {
  id          String        @id @default(cuid())
  orderNumber String        @unique // e.g. JFY-000123

  // Client / pickup contact identity — intake-level, manager-editable only after creation
  // These, plus orderNumber below, are what actions/orders.ts:listOrders searches
  // (case-insensitive substring match). See the trigram-index migration
  // (prisma/migrations/20260902010000_add_trigram_search_indexes) — raw SQL, not
  // expressed here, since Prisma's DSL only gets GIN/pg_trgm support behind a preview
  // feature this app doesn't otherwise need.
  clientName         String
  clientPhone        String
  clientEmail        String?
  pickupContactName  String?
  pickupContactPhone String?
  dueDate            DateTime?

  generalNotes  String?       @db.Text // working-profile-level, employee or manager editable
  status        OrderStatus   @default(IN_PROGRESS)
  paymentStatus PaymentStatus @default(UNPAID)

  // Structured rush flag — set at intake (either role) or edited afterward like the
  // other intake-classification fields (manager only, via updateOrderIntake). Exists
  // so "what share of business is rush work" is a real, countable query instead of
  // grepping freeform price-line text for the word "rush".
  isRush Boolean @default(false)

  // Denormalized sum of every PriceLine on this order (item-level + order-level),
  // recomputed by lib/pricing.ts any time a line is added/edited/removed. This field
  // stays visible to employees (so they can answer "how much do I owe") even though
  // the itemized PriceLine rows themselves are manager-only once the order exists —
  // see actions/orders.ts:getOrderDetail for where that redaction happens.
  totalPriceCents Int @default(0)

  // Public read-only client link. No expiration by design decision; a manager can
  // rotate it (see actions/orders.ts:rotateClientToken) as a manual safety valve.
  clientToken String @unique

  sealedAt   DateTime?
  sealedById String?

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     OrderItem[]
  auditLogs AuditLog[]
  // Order-level price lines only (orderItemId null on PriceLine) — e.g. a rush fee
  // not tied to any single garment. Per-item lines are reached via OrderItem.priceLines.
  priceLines PriceLine[]

  @@index([status])
  @@index([clientName])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Intake-level identity fields — locked after creation, manager-editable only
  garmentType       String
  description       String
  alterations       String[] // selected taxonomy labels
  alterationsCustom String? // free-text extra instructions

  status       ItemStatus @default(PENDING)
  // Set once, the first time this item moves PENDING -> IN_PROGRESS (see
  // actions/items.ts:setItemStatus) — never overwritten by a later reopen, so it
  // answers "how long before anyone touched this" (intake -> first work), not "when
  // was work last resumed." Nullable because items created before this field existed
  // (and any item never yet started) have no value here.
  startedAt     DateTime?
  completedAt   DateTime?
  completedById String?
  reopenedAt    DateTime?
  reopenedById  String?

  // Per-item work assignment — informational only (see actions/items.ts): it labels
  // who's responsible for this item and feeds the workload analytics, but does NOT
  // gate who can change its status. assignedById records who made the assignment
  // (equals assignedToId for a self-claim, or a manager's id for a manager assignment
  // or reassignment) — assignedToId alone can't tell those apart. Both cleared back to
  // null on release, same as any other "undo" in this app leaves no dangling state.
  assignedToId String?
  assignedTo   User?     @relation("ItemAssignedTo", fields: [assignedToId], references: [id])
  assignedById String?
  assignedBy   User?     @relation("ItemAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime?

  // Soft-removal for an item added entirely by mistake (duplicate, wrong garment) — see
  // actions/items.ts:removeItem. Only ever settable while status is PENDING or
  // IN_PROGRESS (never on a COMPLETED/PICKED_UP item — at that point it's real
  // operational history, not a data-entry mistake, and updateItemIntake is the right
  // tool to fix its details instead). A removed item's notes/measurements/price lines
  // are untouched and stay visible to a manager; it's just hidden from the public
  // tracking page and excluded from status computation and analytics.
  removedAt    DateTime?
  removedById  String?
  removedBy    User?     @relation("ItemRemovedBy", fields: [removedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes        ItemNote[]
  measurements ItemMeasurement[]
  images       ItemImage[]
  pickup       ItemPickup?
  priceLines   PriceLine[]

  @@index([orderId])
  @@index([status])
  @@index([assignedToId])
}

// Working-profile notes for employees. Not strictly append-only: the author can
// correct their own note (typo, wrong measurement jotted down in the moment), and a
// manager can correct or remove anyone's — see actions/items.ts:editItemNote/
// deleteItemNote. Unlike AuditLog these are informal working text, not an
// accountability trail of actions taken, so a free-form correction path makes sense
// here. What preserves reliability isn't a lock on who can edit — it's that every
// edit/delete is itself audit-logged with the note's previous text, so nothing is
// ever silently rewritten even by its own author.
model ItemNote {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
}

// Flexible key/value so measurement fields can differ by garment type
// (e.g. "Sleeve length" for a jacket, "Hem to floor" for a gown).
model ItemMeasurement {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  label       String
  value       String
  updatedById String
  updatedBy   User      @relation(fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderItemId])
}

// Image capture is a visible placeholder in Phase 1: the record (who, when, caption)
// is real, but `url` stays null until cloud storage is wired up. See lib/images.ts.
model ItemImage {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  url         String? // null = placeholder, not yet backed by real storage
  caption     String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([orderItemId])
}

model ItemPickup {
  id              String    @id @default(cuid())
  orderItemId     String    @unique
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  pickedUpByName  String
  pickedUpByPhone String?
  authorizedById  String
  authorizedBy    User      @relation("PickupAuthorizedBy", fields: [authorizedById], references: [id])
  pickedUpAt      DateTime  @default(now())
}

// Itemized pricing, receipt-style. Rows can be created two ways:
//   1. During intake creation (createIntakeTicket) — employee OR manager, one-shot.
//   2. Afterward, only through actions/pricing.ts, which is MANAGER ONLY.
// There's no separate "locked" flag on the row itself: the lock is enforced entirely
// by which code path is allowed to write after the order exists (see actions/pricing.ts).
// Visibility is a *different* axis from editability — actions/orders.ts:getOrderDetail
// strips these rows out of the payload entirely for employees once the order exists,
// so an employee never receives the breakdown even read-only. Only Order.totalPriceCents
// and Order.paymentStatus stay visible to them.
model PriceLine {
  id          String @id @default(cuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Null = order-level line not tied to a specific garment (e.g. a rush fee).
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  description String
  amountCents Int
  source      PriceLineSource @default(FREEFORM)

  createdById String
  createdBy   User   @relation("PriceLineCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?  @relation("PriceLineUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([orderItemId])
}

// The accountability trail: every mutation across the system writes one of these.
model AuditLog {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entityType    String // "ORDER" | "ORDER_ITEM" | "EMPLOYEE" | "TAXONOMY" | "PUNCH" | "SHIFT"
  entityId      String
  action        String // e.g. "INTAKE_CREATED", "STATUS_CHANGE", "PICKUP_AUTHORIZED"
  summary       String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([entityType, entityId])
  // Serves the manager audit report (actions/audit-report.ts), which always filters by a
  // date range first (optionally narrowed further by category/action or performedBy) —
  // a plain index on createdAt covers that leading filter regardless of which optional
  // filters are layered on top of it.
  @@index([createdAt])
}

model GarmentTypeOption {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
  sortOrder Int  @default(0)
}

model AlterationTypeOption {
  id     String  @id @default(cuid())
  label  String  @unique
  active Boolean @default(true)
  sortOrder Int  @default(0)
}

// Singleton row used to hand out sequential, human-readable order numbers.
model OrderCounter {
  id         Int @id @default(1)
  lastNumber Int @default(0)
}

// ============================================================================
// Phase 2 — Timeclock & Scheduling
// ============================================================================
// Built separately from Phase 1's order-ticket workflow above, but living in the same
// schema/database now that it's been reviewed and wired in (see phase2/PLAN.md for the
// full evaluation trail — why not Homebase's own API, why not TimeTrex Community
// Edition, why native). Gated behind PHASE2_ENABLED (lib/feature-flags.ts) at the
// application layer — these tables exist and can be written to regardless of the flag,
// which is deliberate: the flag controls staff-facing access, not data existence, so
// toggling it off doesn't touch anything already recorded.
//
// Scope, deliberately: raw punch capture, hours-worked totals, and scheduling only.
// No pay rate, no overtime multiplier, no payroll export — see lib/hours.ts's header.
// That's on hold until how payroll/accounting actually runs today is confirmed.

// BREAK_START/BREAK_END = a short paid break (counted as worked time, not subtracted).
// LUNCH_START/LUNCH_END = an unpaid meal period (subtracted from worked time). See
// lib/hours.ts's computeWorkedMinutes for exactly where that distinction is applied — the
// shop doesn't hardcode break/lunch lengths or counts here, just which kind is paid.
enum PunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
  LUNCH_START
  LUNCH_END
}

// A punch is a single timestamped event, not a stored "shift record" — mirrors how an
// actual time clock works. lib/hours.ts pairs these back into work sessions for
// display; nothing stores a precomputed "hours worked" total, so correcting a bad punch
// automatically fixes every total derived from it instead of leaving a stale cached
// number behind.
model Punch {
  id String @id @default(cuid())

  // Whose time this is. Almost always also the creator (a self-punch), except for a
  // manager's manual add for a missed punch — see createdById below.
  userId String
  user   User   @relation("PunchOwner", fields: [userId], references: [id])

  type      PunchType
  timestamp DateTime

  note String? // optional free text ("forgot to clock out, adding from memory")

  // Who actually created this row — the same person for a normal self-punch, or a
  // manager for a manual add / backfilled missed punch. Same split as OrderItem's
  // assignedToId vs. assignedById: userId alone can't tell "self-punched" from
  // "manager entered this on their behalf" apart.
  createdById String
  createdBy   User     @relation("PunchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // Manager correction trail. A punch is never silently rewritten — see
  // actions/punches.ts:correctPunch, which requires MANAGER and writes the previous
  // timestamp/type into the audit summary (mirrors ItemNote's edit-audit pattern: the
  // correction itself is the accountability trail, not an extra column).
  editedAt   DateTime?
  editedById String?
  editedBy   User?     @relation("PunchEditedBy", fields: [editedById], references: [id])

  // Soft-void for a punch that shouldn't count at all (duplicate double-tap, test
  // punch) — same philosophy as Order.CANCELLED / OrderItem.removedAt: never deleted,
  // excluded from hours totals and from lib/hours.ts's session pairing.
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PunchVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  @@index([userId, timestamp])
}

model Shift {
  id String @id @default(cuid())

  userId String
  user   User   @relation("ShiftAssignee", fields: [userId], references: [id])

  startAt DateTime
  endAt   DateTime
  role    String? // optional label, e.g. "Front counter", "Alterations bench"
  note    String?

  // Draft until a manager explicitly publishes it — see actions/shifts.ts:
  // publishShifts. Employees only ever see published, non-cancelled shifts (their "my
  // schedule" view); a draft is manager-only, same idea as Order's pre-seal editability.
  publishedAt DateTime?

  createdById String
  createdBy   User     @relation("ShiftCreatedBy", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // Soft-cancel, same pattern as Order.CANCELLED — a shift that shouldn't have existed
  // (wrong person scheduled, duplicate) stays in history rather than being deleted.
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("ShiftCancelledBy", fields: [cancelledById], references: [id])

  @@index([userId, startAt])
  @@index([startAt])
}
